{
  "domain": "irobot_advanced",
  "name": "iRobot Advanced",
  "codeowners": [
    "@sam3gp8"
  ],
  "config_flow": true,
  "dependencies": [
    "http",
    "frontend",
    "panel_custom"
  ],
  "dhcp": [
    {
      "hostname": "roomba-*"
    },
    {
      "hostname": "irobot-*"
    },
    {
      "hostname": "braava-*"
    }
  ],
  "documentation": "https://github.com/sam3gp8/ha-irobot-advanced",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/sam3gp8/ha-irobot-advanced/issues",
  "requirements": [
    "paho-mqtt>=1.6.1",
    "Pillow>=10.0.0"
  ],
  "version": "0.6.1",
  "zeroconf": [
    {
      "type": "_mqtt._tcp.local.",
      "name": "roomba*"
    },
    {
      "type": "_mqtt._tcp.local.",
      "name": "irobot*"
    },
    {
      "type": "_mqtt._tcp.local.",
      "name": "braava*"
    }
  ]
}
